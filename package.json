{
  "name": "ErwartungshorizontStudio",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --emptyOutDir",
    "check:release": "npm run lint && npm run typecheck && npm run test && npm run test:regression && npm run build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"e2e/**/*.ts\" \"vite.config.ts\" \"vitest.config.ts\" \"playwright.config.ts\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:regression": "rm -rf .regression-dist && tsc -p tsconfig.regression.json && printf '{\"type\":\"commonjs\"}' > .regression-dist/package.json && node regression/run.cjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1",
    "valibot": "^1.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
